[Unit]
Description=Move b's desktop into the hypr-rdp session while one is connected
PartOf=graphical-session.target
After=graphical-session.target hypr-rdp.service

[Service]
ExecStart=%h/.local/bin/hypr-rdp-session-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
