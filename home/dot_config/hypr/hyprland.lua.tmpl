-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Disable all Omarchy default bindings. Add your own in hypr/bindings.lua.
-- omarchy_default_bindings = false
--
-- Or disable only bindings for Omarchy's preinstalled apps/web apps while
-- keeping core window-manager bindings:
-- omarchy_preinstalled_bindings = false

-- Load Omarchy defaults.
require("default.hypr.omarchy")

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.shared_bindings")
{{- if eq .chezmoi.hostname "b" }}
require("hypr.mx_keys")
{{- end }}
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- Add any other personal Hyprland configuration below.
-- o.window("qemu", { workspace = "5" })

-- WinApps RemoteApp windows (class forced by ~/.local/bin/winapps-freerdp): Windows
-- owns their geometry, so tiling/resizing leaves garbage; keep them floating and opaque.
o.window("^winapps$", { float = true, tag = "-default-opacity", opacity = "1 1" })

-- espanso search bar and forms are popups; tiled, they fill half the screen.
o.window("^espanso$", { float = true, center = true })

-- espanso (re)start maps a gradient "Espanso Sync Tool" window and blocks until it gets
-- keyboard focus to read modifier state (espanso-detect/src/evdev/sync/wayland.rs).
-- Hide it and force focus so it closes by itself instead of waiting for a click.
o.window("^Espanso\\.SyncTool$", {
  tag = "-default-opacity",
  float = true,
  size = { 1, 1 },
  move = { 0, 0 },
  opacity = "0 0",
  border_size = 0,
  no_shadow = true,
  no_blur = true,
  no_anim = true,
  stay_focused = true,
})

-- Keep X11 coordinates in Hyprland's logical layout (Omarchy enables zero scaling).
-- With mixed monitor scales, zero scaling makes X and Hyprland disagree on window
-- positions, which offsets/clips WinApps RemoteApp content. Cost: X11 apps are
-- upscaled (blurry) on the 1.6x laptop panel. Needs a re-login to take effect.
{{ if eq .chezmoi.hostname "stth-zbook-8" -}}
hl.config({ xwayland = { force_zero_scaling = false } })
{{ end -}}

-- Apps pinned to workspaces (per host, from .chezmoidata/workspaces.toml; silent = don't steal focus).
{{- range get (get .workspaces .chezmoi.hostname | default dict) "apps" }}
o.window({{ .class | quote }}, { workspace = "{{ .workspace }}{{ if get . "silent" }} silent{{ end }}" }) -- {{ .name }}
{{- end }}

-- SUPER+SHIFT+Home: send those apps back to their workspaces (e.g. after dragging one to the ultrawide).
o.bind("SUPER + SHIFT + Home", "Send pinned apps home", function()
{{- range get (get .workspaces .chezmoi.hostname | default dict) "apps" }}
  pcall(hl.dispatch, hl.dsp.window.move({ workspace = "{{ .workspace }}", follow = false, window = {{ printf "class:%s" .class | quote }} })) -- {{ .name }}
{{- end }}
end)
