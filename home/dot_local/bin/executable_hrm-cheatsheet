#!/usr/bin/env python3
# Toggle an on-screen cheat sheet for the kanata home row mods
# (dot_config/kanata/kanata.kbd). Colours follow the current Omarchy theme.

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

NAME = "hrm-cheatsheet"
OUT = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"{NAME}.png"



def sheets():
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    return [c for c in json.loads(out or "[]") if c["class"] == "imv" and NAME in c["title"]]


def dispatch(action):
    subprocess.run(["hyprctl", "dispatch", action], capture_output=True)


# Close the sheet if it's already open.
if open_sheets := sheets():
    for c in open_sheets:
        dispatch(f'hl.dsp.window.close({{ window = "address:{c['address']}" }})')
    sys.exit()

colors = {
    "background": "#121212", "foreground": "#c8c8c8", "accent": "#7c7ca8",
    "color1": "#ea90a8", "color2": "#a6b2c7", "color6": "#919ab7", "color8": "#434343",
}
theme = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
if theme.exists():
    for k, v in re.findall(r'^(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', theme.read_text(), re.M):
        colors[k] = v

MODS = {
    "Alt": colors["color1"],
    "Ctrl": colors["color6"],
    "Super": colors["accent"],
    "Shift": colors["color2"],
}
HRM = {"A": "Alt", "S": "Ctrl", "D": "Super", "F": "Shift", "J": "Shift", "K": "Super", "L": "Ctrl", "Ø": "Alt"}

# Norwegian ISO layout: (label, width in key units).
ROWS = [
    [("|", 1), ("1", 1), ("2", 1), ("3", 1), ("4", 1), ("5", 1), ("6", 1), ("7", 1), ("8", 1), ("9", 1),
     ("0", 1), ("+", 1), ("\\", 1), ("⌫", 2)],
    [("Tab", 1.5), ("Q", 1), ("W", 1), ("E", 1), ("R", 1), ("T", 1), ("Y", 1), ("U", 1), ("I", 1), ("O", 1),
     ("P", 1), ("Å", 1), ("¨", 1), ("", 1.5)],
    [("Caps", 1.75), ("A", 1), ("S", 1), ("D", 1), ("F", 1), ("G", 1), ("H", 1), ("J", 1), ("K", 1), ("L", 1),
     ("Ø", 1), ("Æ", 1), ("'", 1), ("⏎", 1.25)],
    [("Shift", 1.25), ("<", 1), ("Z", 1), ("X", 1), ("C", 1), ("V", 1), ("B", 1), ("N", 1), ("M", 1), (",", 1),
     (".", 1), ("-", 1), ("Shift", 2.75)],
    [("Ctrl", 1.5), ("Fn", 1), ("Super", 1.25), ("Alt", 1.25), ("", 6), ("AltGr", 1.25), ("Ctrl", 1.25), ("", 1.5)],
]

U, GAP, PAD = 72, 6, 36
width = int(15 * U + 2 * PAD)
kb_height = len(ROWS) * U
height = int(PAD + 56 + kb_height + 110 + PAD)
font = "JetBrainsMono Nerd Font, monospace"
fg, bg, dim = colors["foreground"], colors["background"], colors["color8"]


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


svg = [
    f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" font-family="{font}">',
    f'<rect width="100%" height="100%" fill="{bg}"/>',
    f'<text x="{PAD}" y="{PAD + 26}" fill="{fg}" font-size="28" font-weight="bold">Home row mods</text>',
    f'<text x="{width - PAD}" y="{PAD + 26}" fill="{fg}" fill-opacity="0.6" font-size="18" text-anchor="end">'
    "tap = letter · hold + key on the other hand = modifier</text>",
]

top = PAD + 56
for r, row in enumerate(ROWS):
    x = PAD
    y = top + r * U
    for label, w in row:
        kw, kh = w * U - GAP, U - GAP
        mod = HRM.get(label) if r == 2 else None
        if mod:
            c = MODS[mod]
            svg.append(f'<rect x="{x}" y="{y}" width="{kw}" height="{kh}" rx="8" fill="{c}" fill-opacity="0.22" '
                       f'stroke="{c}" stroke-width="2.5"/>')
            svg.append(f'<text x="{x + kw / 2}" y="{y + 30}" fill="{fg}" font-size="24" font-weight="bold" '
                       f'text-anchor="middle">{esc(label)}</text>')
            svg.append(f'<text x="{x + kw / 2}" y="{y + kh - 10}" fill="{c}" font-size="14" font-weight="bold" '
                       f'text-anchor="middle">{mod}</text>')
        else:
            svg.append(f'<rect x="{x}" y="{y}" width="{kw}" height="{kh}" rx="8" fill="none" '
                       f'stroke="{dim}" stroke-width="1.5"/>')
            size = 20 if len(label) == 1 else 14
            svg.append(f'<text x="{x + kw / 2}" y="{y + kh / 2 + size / 3}" fill="{fg}" fill-opacity="0.45" '
                       f'font-size="{size}" text-anchor="middle">{esc(label)}</text>')
        x += w * U

# Legend
ly = top + kb_height + 40
lx = PAD
for mod, c in MODS.items():
    svg.append(f'<rect x="{lx}" y="{ly - 18}" width="22" height="22" rx="5" fill="{c}" fill-opacity="0.22" '
               f'stroke="{c}" stroke-width="2.5"/>')
    keys = " / ".join(k for k, m in HRM.items() if m == mod)
    svg.append(f'<text x="{lx + 32}" y="{ly}" fill="{fg}" font-size="18"><tspan fill="{c}" font-weight="bold">'
               f'{mod}</tspan>  {esc(keys)}</text>')
    lx += 250
svg.append(f'<text x="{PAD}" y="{ly + 48}" fill="{fg}" fill-opacity="0.6" font-size="16">'
           "K+J or D+F together = Super+Shift · same-hand rolls stay letters · exit: Ctrl+Space+Esc</text>")
svg.append("</svg>")

subprocess.run(["rsvg-convert", "--zoom", "2", "-o", str(OUT)], input="\n".join(svg).encode(), check=True)
subprocess.Popen(["imv", "-b", bg.lstrip("#"), str(OUT)], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# imv sets its title after mapping, so a window rule can't size it; do it here.
for _ in range(40):
    if found := sheets():
        win = f"address:{found[0]['address']}"
        dispatch(f'hl.dsp.window.resize({{ x = {width}, y = {height}, window = "{win}" }})')
        dispatch(f'hl.dsp.window.center({{ window = "{win}" }})')
        break
    time.sleep(0.05)
