#!/bin/bash
# Reset display outputs when a monitor gets no picture.
# A monitor unplugged during suspend can leave its CRTC bound in the kernel
# after Hyprland has forgotten it, so the next monitor fails every modeset.
# Switching VT hands the display to the kernel console, which resets all
# CRTCs; Hyprland then re-applies its outputs when we switch back.

set -euo pipefail

session=${XDG_SESSION_ID:-$(loginctl list-sessions --no-legend | awk -v u="$USER" '$3 == u && $4 != "" { print $1; exit }')}
vt=$(loginctl show-session "$session" -p VTNr --value)
other=$((vt == 2 ? 3 : 2))

pkexec sh -c "chvt $other && sleep 2 && chvt $vt"
sleep 2

# Outputs whose last modeset failed stay at 0x0 until a rule is re-applied.
hyprctl reload >/dev/null
sleep 2
for name in $(hyprctl monitors -j | jq -r '.[] | select(.width == 0) | .name'); do
  hyprctl eval "hl.monitor({ output = \"$name\", mode = \"preferred\", position = \"auto\", scale = \"auto\" })" >/dev/null
done

notify-send -a "Display Reset" "Display Reset" "$(hyprctl monitors -j | jq -r '.[] | "\(.name): \(.width)x\(.height)"')"
