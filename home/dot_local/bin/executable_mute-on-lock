#!/bin/bash
# Mute the default speaker whenever the session locks or the machine suspends.

mute() { wpctl set-mute @DEFAULT_AUDIO_SINK@ 1; }

# Suspend (lid close): mute as soon as logind announces sleep.
dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" |
  while read -r line; do [[ $line == *"boolean true"* ]] && mute; done &

# Lock (idle, Super+Ctrl+L, or before suspend): mute on the unlocked -> locked transition.
was_locked=false
while sleep 1; do
  locked=$(omarchy-shell lock isLocked 2>/dev/null)
  [[ $locked == true && $was_locked != true ]] && mute
  was_locked=$locked
done
