{{ if lookPath "mise" -}}
# mise: put the shims first on PATH and drop any mise install dirs. Shims pick
# the tool version per directory each time a command runs, so they suit
# shells with no prompt hook (bash -lc, ssh commands, coding-agent shells).
# Shims also go ahead of /usr/bin so system node/go never win.
__mise_shims_first() {
  local data="${MISE_DATA_DIR:-$HOME/.local/share/mise}" out="" d
  local -a parts
  IFS=: read -ra parts <<<"$PATH"
  for d in "${parts[@]}"; do
    case "$d" in "$data/shims" | "$data/installs/"*) continue ;; esac
    out="${out:+$out:}$d"
  done
  export PATH="$data/shims${out:+:$out}"
}
if [[ $- != *i* ]]; then
  __mise_shims_first
  unset -f __mise_shims_first
fi
{{- end }}

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

{{/* Omarchy specific */}}
{{- if lookPath "omarchy-version" }}
# Omarchy defaults
# /etc/omarchy.conf is written by omarchy-dev-link. When absent, force the
# package default instead of preserving a stale inherited dev-link value before
# we decide which rc file to source.
if [[ -f /etc/omarchy.conf ]]; then
  source /etc/omarchy.conf
  export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
else
  export OMARCHY_PATH=/usr/share/omarchy
fi
source "$OMARCHY_PATH/default/bash/rc"
{{- end }}

{{/* If not on Omarchy */}}
{{- if not (lookPath "omarchy-version") }}

export PATH="$HOME/.local/bin:$PATH"

alias ..='cd ..'
alias ...='cd ../..'
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias g='git'
alias gcm='git cm'
alias doc='lazydocker'

{{- if lookPath "starship" }}
# Starship prompt
eval "$(starship init bash)"
{{- end }}

{{- end }}

{{/* Homebrew */}}
{{- if or (lookPath "brew") (stat "/home/linuxbrew/.linuxbrew/bin/brew") }}
# Homebrew
export HOMEBREW_NO_ENV_HINTS=1
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}


# Aliases
alias dot=chezmoi
alias s='jq ".scripts" package.json'
alias p='pnpm'
alias m='mekk'
alias rmr='rm -rf --one-file-system --preserve-root'
alias galias="git config --get-regexp '^alias\.'"
alias gtree='git ls-files | tree --fromfile'
alias cc='cursor . 2>/dev/null'
alias ai='CLAUDE_SWITCH_ARGS=--dangerously-skip-permissions claude-switch'

mcd() {
  mkdir -p "$1" && cd "$1"
}

# Edit bash profile
ep() {
  local file="$HOME/.bashrc"

  # Open source state, then apply to target when editor exits
  chezmoi edit --apply "$file" || return

  # Re-source only if we're in an interactive shell
  if [[ $- == *i* ]]; then
    # shellcheck source=/dev/null
    . "$file"
    echo "Reloaded $file"
  fi
}

# npm global path
export PATH="$HOME/.npm-global/bin:$PATH"
# graft: keep its /graft/ entry out of repo .gitignore files (globally ignored instead)
export GRAFT_NO_GITIGNORE=1

{{- if and (lookPath "mise") (not (lookPath "omarchy-version")) }}
# node + cli tools via mise (honors .node-version / .tool-versions / mise.toml).
# Omarchy's default rc already runs this.
eval "$(mise activate bash)"
{{- end }}

{{/* Fast Node Manager */}}
{{- if or (lookPath "fnm") (stat (joinPath .chezmoi.homeDir ".local" "share" "fnm")) }}
export FNM_MULTISHELL_PATH="$HOME/.cache/fnm_multishells"
mkdir -p "$FNM_MULTISHELL_PATH"
FNM_PATH="$HOME/.local/share/fnm"
export PATH="$FNM_PATH:$PATH"
eval "$(fnm env --use-on-cd --shell bash)"
{{- end }}

# Bookmarks
source ~/.config/bash/bookmarks/b


# Load user-specific bash completions
if [ -d ~/.config/bash/completion.d ]; then
  for f in ~/.config/bash/completion.d/*; do
    [ -r "$f" ] && source "$f"
  done
fi

# Android sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export PATH=$PATH:$ANDROID_SDK_ROOT/emulator:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin

{{/* pnpm */}}
{{- if or (lookPath "pnpm") (stat (joinPath .chezmoi.homeDir ".local" "share" "pnpm")) }}
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
{{- end }}

{{/* Rust (cargo) */}}
{{- if lookPath "rustc" }}
export CARGO_HOME="$HOME/.cargo"
case ":$PATH:" in
  *":$CARGO_HOME/bin:"*) ;;
  *) export PATH="$CARGO_HOME/bin:$PATH" ;;
esac
{{- end }}

{{/* Go */}}
{{- if lookPath "go" }}
export GOPATH="$HOME/go"
case ":$PATH:" in
  *":$GOPATH/bin:"*) ;;
  *) export PATH="$GOPATH/bin:$PATH" ;;
esac
{{- end }}

{{- if lookPath "mise" }}
# mise in agent shells. Claude Code and Codex source this file once in an
# interactive shell with no terminal and snapshot the PATH. The prompt hook
# from `mise activate` never fires there, so the PATH would stay pinned to the
# versions of the startup directory. Swap to shims instead. Humans at a real
# terminal keep the prompt hook.
if [[ ! -t 0 || -n ${CLAUDECODE-} || -n ${CODEX_THREAD_ID-} ]]; then
  if declare -F _mise_hook >/dev/null; then
    eval "$(command mise deactivate 2>/dev/null)"
  fi
  __mise_shims_first
fi
unset -f __mise_shims_first
{{- end }}

# Auto-attach to the persistent herdr session on SSH/mosh login.
# HERDR_ENV is set inside herdr panes, so this only fires on the outer
# login shell, never when herdr spawns a new pane/tab that re-sources this file.
# mosh sessions inherit SSH_CONNECTION from the bootstrap ssh connection that
# started mosh-server, so this check catches both.
if [[ -z "$HERDR_ENV" ]] && [[ -n "$SSH_CONNECTION" ]] && command -v herdr >/dev/null 2>&1; then
  herdr
fi
