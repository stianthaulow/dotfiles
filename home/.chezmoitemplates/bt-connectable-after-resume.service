# Classic Bluetooth keyboards (Keychron K3) can't reconnect after s2idle resume:
# the MT7925 stops page scanning. Keep the controller connectable at boot and after every wake.
# (A 2-minute window wasn't enough: the K3 only reconnected if woken right after the laptop.)
[Unit]
Description=Keep Bluetooth connectable (boot and resume)
After=bluetooth.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
Wants=bluetooth.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/bin/bt-connectable on

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
